# ============================================================
# Digital Agreement Signing — environment configuration
# Copy this file to `.env` and adjust the values.
#   cp .env.example .env
# NEVER commit the real .env file (it is already in .gitignore).
# ============================================================

# --- Core Django ---
# Generate a strong key:  python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
# Comma-separated list of hosts that may serve the app
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (PostgreSQL for docker-compose) ---
# The web service in docker-compose.yml uses these variables:
POSTGRES_DB=digital_agreement
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Alternatively, a single URL: DATABASE_URL=postgres://user:pass@db:5432/dbname

# --- CORS ---
# Comma-separated list of origins allowed to call the API (the frontend origin)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- JWT / cookies ---
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=7
# Set COOKIE_SECURE=True when serving over HTTPS (recommended in production)
COOKIE_SECURE=False
# SameSite for the refresh cookie: Lax (same-site), or None (cross-site over HTTPS)
COOKIE_SAMESITE=Lax

# --- Email notifications ---
# Development default prints emails to the server log:
#   EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Production SMTP example (Gmail with an App Password, Brevo, Mailgun, etc.):
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Digital Agreement Signing <no-reply@example.com>

# --- Bootstrap admin (created when the DB has no superuser) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@12345
ADMIN_EMAIL=admin@example.com

# --- Security (production, HTTPS) ---
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# CSRF_TRUSTED_ORIGINS=https://your-domain.com
